          "content": {
            "size": -1,
            "mimeType": "application/json",
            "text": "[{\"book_number\":1,\"name\":\"Genesis\",\"name_zh\":\"創世紀\",\"name_zh_simplified\":\"创世纪\",\"testament\":\"OT\",\"total_chapters\":50},{\"book_number\":2,\"name\":\"Exodus\",\"name_zh\":\"出埃及記\",\"name_zh_simplified\":\"出埃及记\",\"testament\":\"OT\",\"total_chapters\":40},{\"book_number\":3,\"name\":\"Leviticus\",\"name_zh\":\"利未記\",\"name_zh_simplified\":\"利未记\",\"testament\":\"OT\",\"total_chapters\":27},{\"book_number\":4,\"name\":\"Numbers\",\"name_zh\":\"民數記\",\"name_zh_simplified\":\"民数记\",\"testament\":\"OT\",\"total_chapters\":36},{\"book_number\":5,\"name\":\"Deuteronomy\",\"name_zh\":\"申命記\",\"name_zh_simplified\":\"申命记\",\"testament\":\"OT\",\"total_chapters\":34},{\"book_number\":6,\"name\":\"Joshua\",\"name_zh\":\"約書亞記\",\"name_zh_simplified\":\"约书亚记\",\"testament\":\"OT\",\"total_chapters\":24},{\"book_number\":7,\"name\":\"Judges\",\"name_zh\":\"士師記\",\"name_zh_simplified\":\"士师记\",\"testament\":\"OT\",\"total_chapters\":21},{\"book_number\":8,\"name\":\"Ruth\",\"name_zh\":\"路得記\",\"name_zh_simplified\":\"路得记\",\"testament\":\"OT\",\"total_chapters\":4},{\"book_number\":9,\"name\":\"1 Samuel\",\"name_zh\":\"撒母耳記上\",\"name_zh_simplified\":\"撒母耳记上\",\"testament\":\"OT\",\"total_chapters\":31},{\"book_number\":10,\"name\":\"2 Samuel\",\"name_zh\":\"撒母耳記下\",\"name_zh_simplified\":\"撒母耳记下\",\"testament\":\"OT\",\"total_chapters\":24},{\"book_number\":11,\"name\":\"1 Kings\",\"name_zh\":\"列王紀上\",\"name_zh_simplified\":\"列王纪上\",\"testament\":\"OT\",\"total_chapters\":22},{\"book_number\":12,\"name\":\"2 Kings\",\"name_zh\":\"列王紀下\",\"name_zh_simplified\":\"列王纪下\",\"testament\":\"OT\",\"total_chapters\":25},{\"book_number\":13,\"name\":\"1 Chronicles\",\"name_zh\":\"歷代志上\",\"name_zh_simplified\":\"历代志上\",\"testament\":\"OT\",\"total_chapters\":29},{\"book_number\":14,\"name\":\"2 Chronicles\",\"name_zh\":\"歷代志下\",\"name_zh_simplified\":\"历代志下\",\"testament\":\"OT\",\"total_chapters\":36},{\"book_number\":15,\"name\":\"Ezra\",\"name_zh\":\"