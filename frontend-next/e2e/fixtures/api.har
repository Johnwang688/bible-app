":3},{\"book_number\":30,\"name\":\"Amos\",\"name_zh\":\"阿摩司書\",\"name_zh_simplified\":\"阿摩司书\",\"testament\":\"OT\",\"total_chapters\":9},{\"book_number\":31,\"name\":\"Obadiah\",\"name_zh\":\"俄巴底亞書\",\"name_zh_simplified\":\"俄巴底亚书\",\"testament\":\"OT\",\"total_chapters\":1},{\"book_number\":32,\"name\":\"Jonah\",\"name_zh\":\"約拿書\",\"name_zh_simplified\":\"约拿书\",\"testament\":\"OT\",\"total_chapters\":4},{\"book_number\":33,\"name\":\"Micah\",\"name_zh\":\"彌迦書\",\"name_zh_simplified\":\"弥迦书\",\"testament\":\"OT\",\"total_chapters\":7},{\"book_number\":34,\"name\":\"Nahum\",\"name_zh\":\"那鴻書\",\"name_zh_simplified\":\"那鸿书\",\"testament\":\"OT\",\"total_chapters\":3},{\"book_number\":35,\"name\":\"Habakkuk\",\"name_zh\":\"哈巴谷書\",\"name_zh_simplified\":\"哈巴谷书\",\"testament\":\"OT\",\"total_chapters\":3},{\"book_number\":36,\"name\":\"Zephaniah\",\"name_zh\":\"西番雅書\",\"name_zh_simplified\":\"西番雅书\",\"testament\":\"OT\",\"total_chapters\":3},{\"book_number\":37,\"name\":\"Haggai\",\"name_zh\":\"哈該書\",\"name_zh_simplified\":\"哈该书\",\"testament\":\"OT\",\"total_chapters\":2},{\"book_number\":38,\"name\":\"Zechariah\",\"name_zh\":\"撒迦利亞書\",\"name_zh_simplified\":\"撒迦利亚书\",\"testament\":\"OT\",\"total_chapters\":14},{\"book_number\":39,\"name\":\"Malachi\",\"name_zh\":\"瑪拉基書\",\"name_zh_simplified\":\"玛拉基书\",\"testament\":\"OT\",\"total_chapters\":4},{\"book_number\":40,\"name\":\"Matthew\",\"name_zh\":\"馬太福音\",\"name_zh_simplified\":\"马太福音\",\"testament\":\"NT\",\"total_chapters\":28},{\"book_number\":41,\"name\":\"Mark\",\"name_zh\":\"馬可福音\",\"name_zh_simplified\":\"马可福音\",\"testament\":\"NT\",\"total_chapters\":16},{\"book_number\":42,\"name\":\"Luke\",\"name_zh\":\"路加福音\",\"name_zh_simplified\":\"路加福音\",\"testament\":\"NT\",\"total_chapters\":24},{\"book_number\":43,\"name\":\"John\",\"name_zh\":\"約翰福音\",\"name_zh_simplified\":\"约翰福音\",\"testament\":\"NT\",\"total_chapters\":21},{\"book_number\":44,\"name\":\"Acts\",\"name_zh\":\"使徒行傳\",\"name_zh_simplified\":\"使徒行传\"