{
  "expo": {
    "name": "Bible App",
    "slug": "bible-app",
    "scheme": "bibleapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bible.client"
    },
    "android": {
      "package": "app.bible.client",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      ["expo-secure-store", { "configureAndroidBackup": true, "faceIDPermission": false }],
      [
        "expo-audio",
        {
          "microphonePermission": "Bible App uses the microphone only while you answer a memory verse by voice."
        }
      ]
    ]
  }
}
