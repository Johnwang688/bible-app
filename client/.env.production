# Production build config for the web beta.
# This file is COMMITTED and holds PUBLIC values only. `expo export` (production mode) loads it and
# inlines every EXPO_PUBLIC_* value into the shipped JavaScript, so anyone can read them.
# NEVER put a secret here (no service-account keys, tokens, passwords, private keys).
# To override locally, use the git-ignored client/.env.production.local.
#
# The Firebase web API key below is a public identifier, not a secret: it names the project to the
# Firebase services and is shipped in every Firebase web app (see Firebase's docs on API keys).
# Access is controlled by Firebase Auth, security rules and authorised domains, not by hiding the key.
EXPO_PUBLIC_API_BASE_URL=https://bible-api-593497511935.us-central1.run.app
EXPO_PUBLIC_RELEASE_CHANNEL=beta
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyApR7OouIzj9sSiZCpFo7FFijlOUTq6_X4
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=bible-app-492520.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=bible-app-492520
EXPO_PUBLIC_FIREBASE_APP_ID=1:593497511935:web:89b4144b659881044ef9ca
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=bible-app-492520.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=593497511935
