# Copy to .env and fill in (never commit .env).

# App (FastAPI)
APP_ENV=development
# Used by deployment/scripts; not required for local sign-in.
APP_SECRET_KEY=

# Optional: when APP_ENV=development, the wallet for this Supabase user email is floored to DEV_WALLET_BALANCE (default 1M).
# Sign in via the normal /signin form with that user’s credentials (no separate dev endpoint).
DEV_ACCOUNT_EMAIL=
# DEV_WALLET_BALANCE=1000000

# Supabase (required for sign-in, account sync, and DB-backed features)
# Project: Supabase dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google AI (quiz batch scripts, etc.)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AI backend for /api/v1/ai/chat, entity text and guided chapters: openai (default), anthropic or vertex.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# Claude via the Anthropic API (AI_PROVIDER=anthropic). Get a key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# Claude via Google Vertex AI (AI_PROVIDER=vertex). Uses Application Default Credentials.
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global
# Claude chat limits: tool-call rounds per question, and the input-token size at which the model must answer.
# AI_MAX_TOOL_ROUNDS=6
# AI_MAX_INPUT_TOKENS=100000
