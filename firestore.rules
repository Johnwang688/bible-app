rules_version = '2';
// Per-user sync data (R-6b). Layout and document shapes: client/src/sync/types.ts; the wire format
// (how the adapter encodes them): client/src/sync/firestoreRemote.ts.
//
//   users/{uid}/items/{kind}:{ref}   one study item (highlight, note, bookmark) or its tombstone
//   users/{uid}/devices/{deviceId}   one device's own reading progress
//   users/{uid}/settings/{key}       one synced setting
//
// Only those three collections are open, and only to their owner. Clients may read and write (create
// or replace) a document whose shape validates; they may never delete one (a deleted study item is a
// tombstone; only the backend's Admin SDK, which bypasses these rules, removes documents). Every other
// path, including users/{uid} itself, matches no rule and is therefore denied.
//
//   deletedUsers/{uid}               { deletedAt }: written by the backend's "delete my data" (Admin SDK).
//                                    Closed to clients. While it exists, only a sign-in after deletedAt
//                                    may write under users/{uid}, so an ID token issued before the delete
//                                    (still valid for up to an hour on another device) cannot recreate data.
//
// Schema-tight (R-6b follow-up 3b). Every document a client may write is checked against the exact schema
// the sync engine writes: its keys, the type and size of every field, and every entry inside its maps and
// lists, so no document can carry data the app does not use. The rules language has no loops, so entries
// are checked all at once: a map's keys (or values, or a list) are joined with ';' into one string that one
// anchored regex validates, and a count proves no entry smuggled in a ';' of its own (an entry of fixed
// width: the joined length; otherwise split(';').size() == the entry count). Joining turns ints into
// digits, so it cannot tell 5 from "5": a device's activeMs (day -> ms) is therefore not a map on the wire
// but one string "YYYY-MM-DD=ms;YYYY-MM-DD=ms" (the adapter encodes and decodes it; the engine's
// DeviceProgress is unchanged). Regexes use [0-9], never \d (the emulator's matcher does not support it).
// Nothing was in production before this scheme, so no document in an older format needs migrating.
//
// The adapter's push path drops or normalises anything the storage schemas allow but these rules refuse
// (and logs a warning), so a push never fails for good on one entry. Limits: these rules validate single
// documents; they cannot count documents, so the number of device documents per user is not capped here
// (each one is bounded: about 700 KB at the caps, under the 1 MiB document limit). App Check and a
// billing budget alert are the controls for that.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers -------------------------------------------------------------------------

    // The signed-in user is the owner of users/{uid}.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The owner may write under users/{uid} unless the account's data was deleted after this sign-in.
    // A uid that was never deleted has no marker; deletedAt is a timestamp, auth_time is in seconds.
    function canWrite(uid) {
      let marker = /databases/$(database)/documents/deletedUsers/$(uid);
      return isOwner(uid) && (
        !exists(marker)
        || request.auth.token.auth_time * 1000 > get(marker).data.deletedAt.toMillis()
      );
    }

    // The map has exactly these keys: none missing, none extra.
    function hasExactly(m, fields) {
      return m.keys().hasAll(fields) && m.keys().hasOnly(fields);
    }

    // A device id exactly as the engine makes it (sync/state.ts DEVICE_ID_RE): 20 of A-Z a-z 0-9 _ -
    // (also the devices document id).
    function isDeviceId(s) {
      return s is string && s.matches('^[A-Za-z0-9_-]{20}$');
    }

    // A client clock in ms: a positive int, at most one day ahead of the server.
    function isClientTime(t) {
      return t is int && t > 0 && t <= request.time.toMillis() + 86400000;
    }

    // The server write time: must be serverTimestamp(), never a client value.
    function isServerTime(t) {
      return t == request.time;
    }

    // ---- Patterns (regex fragments; anchored where used) -----------------------------------------

    // A calendar day "2026-11-02" (storage/keys.ts dayKeySchema; month and day ranges, not leap years).
    function dayRe() {
      return '[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])';
    }

    // A time exactly as Date.toISOString() writes it: "2026-11-02T10:00:00.000Z", always 24 characters.
    function isoRe() {
      return dayRe() + 'T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z';
    }

    // A chapter "43:3": book 1..66, chapter 1..150, no leading zeros (storage/keys.ts chapterKey).
    function chapterRe() {
      return '([1-9]|[1-5][0-9]|6[0-6]):([1-9]|[1-9][0-9]|1[0-4][0-9]|150)';
    }

    // Reading ms in one day: 0..86400000, no leading zeros.
    function dayMsRe() {
      return '(0|[1-9][0-9]{0,6}|[1-7][0-9]{7}|8[0-5][0-9]{6}|86[0-3][0-9]{5}|86400000)';
    }

    // Zero or more `entry`, separated by ';'.
    function listRe(entry) {
      return '^(' + entry + '(;' + entry + ')*)?$';
    }

    function isIsoTime(s) {
      return s is string && s.matches('^' + isoRe() + '$');
    }

    // ---- Study items: users/{uid}/items/{kind}:{ref} ---------------------------------------------

    // The id is a kind and a verse: book 1..66, chapter and verse 1..999 without leading zeros.
    function isItemId(id) {
      return id.matches('^(highlight|note|bookmark):([1-9]|[1-5][0-9]|6[0-6]):[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$');
    }

    // A live highlight value: { colour } with one of the six colour ids (theme/highlights.ts).
    function isHighlightValue(v) {
      return hasExactly(v, ['colour'])
        && v.colour in ['yellow', 'orange', 'pink', 'purple', 'blue', 'green'];
    }

    // A live note value: { text } of 1..5000 characters (storage/keys.ts NOTE_MAX_LENGTH).
    function isNoteValue(v) {
      return hasExactly(v, ['text'])
        && v.text is string && v.text.size() >= 1 && v.text.size() <= 5000;
    }

    // A live bookmark value: { createdAt }, an ISO time.
    function isBookmarkValue(v) {
      return hasExactly(v, ['createdAt']) && isIsoTime(v.createdAt);
    }

    // A tombstone has a null value; a live item has the value of its kind.
    function isItemValue(d) {
      return d.deleted == true
        ? d.value == null
        : d.value is map && (
            d.kind == 'highlight' ? isHighlightValue(d.value)
            : d.kind == 'note' ? isNoteValue(d.value)
            : d.kind == 'bookmark' && isBookmarkValue(d.value)
          );
    }

    function isItem(itemId, d) {
      return isItemId(itemId)
        && hasExactly(d, ['kind', 'ref', 'deleted', 'value', 'updatedAt', 'deviceId', 'serverTime'])
        && d.kind is string && d.ref is string
        && itemId == d.kind + ':' + d.ref
        && d.deleted is bool
        && isItemValue(d)
        && isClientTime(d.updatedAt)
        && isDeviceId(d.deviceId)
        && isServerTime(d.serverTime);
    }

    // ---- Device progress: users/{uid}/devices/{deviceId} ----------------------------------------

    // activeMs on the wire: one string "day=ms;day=ms" of at most 20000 days (see the header). An entry is
    // at most 20 characters with its ';', so the size check bounds the regex's input first.
    function isActiveMs(s) {
      return s is string
        && s.size() <= 400000
        && s.matches(listRe(dayRe() + '=' + dayMsRe()))
        && s.split(';').size() <= 20000;
    }

    // chaptersRead: a map of at most 1189 chapters, each to the ISO time it was first credited. The joined
    // keys may vary in width, so split() counts them; the times are 24 characters, so the length does.
    function isChaptersRead(m) {
      return m is map && m.size() <= 1189 && (
        m.size() == 0 || (
          m.keys().join(';').matches(listRe(chapterRe()))
          && m.keys().join(';').split(';').size() == m.size()
          && m.values().join(';').matches(listRe(isoRe()))
          && m.values().join(';').size() == m.size() * 25 - 1
        )
      );
    }

    // goalMetDays: a list of at most 20000 distinct days (10 characters each).
    function isDayList(l) {
      return l is list && l.size() <= 20000 && (
        l.size() == 0 || (
          l.join(';').matches(listRe(dayRe()))
          && l.join(';').size() == l.size() * 11 - 1
          && l.toSet().size() == l.size()
        )
      );
    }

    // The daily goal as the device last set it: null, or { minutes 5..120 in steps of 5, updatedAt
    // (a client clock) }.
    function isGoal(g) {
      return g == null || (
        g is map && hasExactly(g, ['minutes', 'updatedAt'])
        && g.minutes is int && g.minutes >= 5 && g.minutes <= 120 && g.minutes % 5 == 0
        && isClientTime(g.updatedAt)
      );
    }

    // `evidence` (device-local) is not allowed.
    function isDevice(deviceId, d) {
      return isDeviceId(deviceId)
        && hasExactly(d, ['deviceId', 'activeMs', 'chaptersRead', 'goalMetDays', 'goal', 'updatedAt', 'serverTime'])
        && d.deviceId == deviceId
        && isActiveMs(d.activeMs)
        && isChaptersRead(d.chaptersRead)
        && isDayList(d.goalMetDays)
        && isGoal(d.goal)
        && isClientTime(d.updatedAt)
        && isServerTime(d.serverTime);
    }

    // ---- Settings: users/{uid}/settings/{key} ---------------------------------------------------

    // An appearance mode and preset as JSON (storage/keys.ts appearanceKey; theme/types.ts PRESET_IDS).
    function modeJsonRe() {
      return '"(system|light|dark)"';
    }

    function presetJsonRe() {
      return '(null|"(strawberry-milk|matcha-latte|lavender-haze|bubblegum-night|matcha-night|grape-soda'
        + '|liberty|silver|sky|northern-lights|graphite|deep-blue)")';
    }

    // The setting's JSON, exactly. The adapter writes keys sorted (mode, preset); the storage order
    // (preset, mode) is accepted too, as the same two fields in the other order.
    function isSettingJson(key, json) {
      return json is string && (
        key == 'language' ? json in ['"system"', '"en"', '"zh-Hans"']
        : key == 'appearance' ? (
            json.matches('^[{]"mode":' + modeJsonRe() + ',"preset":' + presetJsonRe() + '[}]$')
            || json.matches('^[{]"preset":' + presetJsonRe() + ',"mode":' + modeJsonRe() + '[}]$')
          )
        // TODO(R-6a): tighten to R-6a's custom-theme schema once it lands; for now any JSON object of at
        // most 4000 characters (types.ts SETTING_JSON_MAX).
        : key == 'appearance.custom' && json.size() <= 4000 && json.matches('^[{].*[}]$')
      );
    }

    function isSetting(key, d) {
      return key in ['appearance', 'appearance.custom', 'language']
        && hasExactly(d, ['key', 'json', 'updatedAt', 'deviceId', 'serverTime'])
        && d.key == key
        && isSettingJson(key, d.json)
        && isClientTime(d.updatedAt)
        && isDeviceId(d.deviceId)
        && isServerTime(d.serverTime);
    }

    // ---- Paths ----------------------------------------------------------------------------------

    // Deletion markers: Admin SDK only (it bypasses rules). Stated explicitly for readability.
    match /deletedUsers/{uid} {
      allow read, write: if false;
    }

    // users/{uid} itself has no rule: denied. Only these three subcollections are open.
    // Reads stay open to the owner; writes also need canWrite (the deletion marker check).
    match /users/{uid} {

      match /items/{itemId} {
        allow get, list: if isOwner(uid);
        allow create, update: if canWrite(uid) && isItem(itemId, request.resource.data);
      }

      match /devices/{deviceId} {
        allow get, list: if isOwner(uid);
        allow create, update: if canWrite(uid) && isDevice(deviceId, request.resource.data);
      }

      match /settings/{key} {
        allow get, list: if isOwner(uid);
        allow create, update: if canWrite(uid) && isSetting(key, request.resource.data);
      }
    }
  }
}
